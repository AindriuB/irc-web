<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.3.5</version>
		<relativePath/>
	</parent>

	<groupId>io.github.aindriub</groupId>
	<artifactId>irc-web</artifactId>
	<version>0.1.0-SNAPSHOT</version>
	<name>irc-web</name>
	<description>A web front end for irc-client, and the exercise that proves the library works</description>
	<url>https://github.com/AindriuB/irc-web</url>

	<licenses>
		<license>
			<name>The Apache License, Version 2.0</name>
			<url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
			<distribution>repo</distribution>
		</license>
	</licenses>

	<developers>
		<developer>
			<id>AindriuB</id>
			<name>Andrew Bannister</name>
			<url>https://github.com/AindriuB</url>
		</developer>
	</developers>

	<scm>
		<connection>scm:git:https://github.com/AindriuB/irc-web.git</connection>
		<developerConnection>scm:git:git@github.com:AindriuB/irc-web.git</developerConnection>
		<url>https://github.com/AindriuB/irc-web</url>
	</scm>

	<properties>
		<java.version>21</java.version>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<irc-client.version>1.0.0</irc-client.version>
	</properties>

	<dependencies>
		<!-- The subject of the exercise. Everything else here exists to drive it. -->
		<dependency>
			<groupId>io.github.aindriub</groupId>
			<artifactId>irc-client</artifactId>
			<version>${irc-client.version}</version>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-websocket</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
			<!-- The tests here are *IT, which surefire does not pick up: a name
			     that does not match its patterns is silently skipped, and a
			     suite that quietly runs nothing is worse than no suite. They
			     drive a real IRC server, so failsafe and mvn verify is the
			     right home for them anyway. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-failsafe-plugin</artifactId>
				<executions>
					<execution>
						<goals>
							<goal>integration-test</goal>
							<goal>verify</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
